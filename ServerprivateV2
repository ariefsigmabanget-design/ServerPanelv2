local function httpGet(url)
    local ok, body = pcall(function() return game:HttpGet(url) end)
    if ok and type(body) == "string" and #body > 0 then return body end
    local requestFn
    pcall(function() if syn and type(syn.request) == "function" then requestFn = syn.request end end)
    if not requestFn then pcall(function() if type(http_request) == "function" then requestFn = http_request end end) end
    if not requestFn then pcall(function() if type(request) == "function" then requestFn = request end end) end
    if requestFn then
        local reqOk, response = pcall(function()
            return requestFn({Url = url, Method = "GET", Headers = {Accept = "application/json"}})
        end)
        local statusCode = type(response) == "table" and tonumber(response.StatusCode or response.Status) or nil
        if reqOk and type(response) == "table" and (not statusCode or statusCode < 400) and type(response.Body) == "string" then
            return response.Body
        end
    end
    error("HTTP request gagal.")
end

local function getPublicServers(placeId, maxPages)
    local servers, cursor = {}, ""
    maxPages = math.clamp(tonumber(maxPages) or 3, 1, 10)
    for page = 1, maxPages do
        local url = "https://games.roblox.com/v1/games/" .. tostring(placeId) .. "/servers/Public?sortOrder=Asc&limit=100"
        if cursor ~= "" then url = url .. "&cursor=" .. HttpService:UrlEncode(cursor) end
        local ok, result = pcall(function() return HttpService:JSONDecode(httpGet(url)) end)
        if not ok or type(result) ~= "table" or type(result.data) ~= "table" then return servers, "Gagal mengambil server." end
        for _, server in ipairs(result.data) do
            if type(server) == "table" and type(server.id) == "string" and tonumber(server.playing) and tonumber(server.maxPlayers) then
                table.insert(servers, server)
            end
        end
        cursor = type(result.nextPageCursor) == "string" and result.nextPageCursor or ""
        if cursor == "" then break end
        task.wait(0.15)
    end
    return servers, nil
end

local function safeTeleport(placeId, jobId, statusLabel)
    if teleportPending then
        if statusLabel then statusLabel.Text = "Teleport sedang diproses..." end
        return false
    end
    if type(jobId) ~= "string" or jobId == "" then
        if statusLabel then statusLabel.Text = "Server ID tidak valid." end
        return false
    end
    teleportPending = true
    if statusLabel then statusLabel.Text = "Menghubungkan..." end
    local ok, err = pcall(function() TeleportService:TeleportToPlaceInstance(placeId, jobId, LocalPlayer) end)
    if not ok then
        teleportPending = false
        if statusLabel then statusLabel.Text = "Teleport gagal: " .. tostring(err) end
        return false
    end
    return true
end

