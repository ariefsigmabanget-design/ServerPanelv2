local REQUEST_LIMIT_FILE = "versmandex_req_limit_v9.json"
local function getRequestLimitData()
    local data = {count = 0, targetTick = 0}
    pcall(function()
        if readfile and isfile and isfile(REQUEST_LIMIT_FILE) then
            local decoded = HttpService:JSONDecode(readfile(REQUEST_LIMIT_FILE))
            if type(decoded) == "table" then data = decoded end
        end
    end)
    return data
end

local function saveRequestLimitData(count, targetTick)
    pcall(function()
        if writefile then
            writefile(REQUEST_LIMIT_FILE, HttpService:JSONEncode({count = count, targetTick = targetTick}))
        end
    end)
end

task.spawn(function()
    while ScreenGui.Parent do
        local data = getRequestLimitData()
        if data.count >= 2 then
            local remaining = data.targetTick - tick()
            if remaining > 0 then
                local hours = math.floor(remaining / 3600)
                local minutes = math.floor((remaining % 3600) / 60)
                local seconds = math.floor(remaining % 60)
                SendReqBtn.Text = string.format("Limit Reached (%02dh %02dm %02ds)", hours, minutes, seconds)
                SendReqBtn.Active = false
                SendReqBtn.BackgroundColor3 = Color3.fromRGB(80, 30, 30)
            else
                saveRequestLimitData(0, 0)
                SendReqBtn.Text = "Send Request"
                SendReqBtn.Active = true
                SendReqBtn.BackgroundColor3 = Color3.fromRGB(45, 45, 55)
            end
        else
            SendReqBtn.Text = "Send Request"
            SendReqBtn.Active = true
            SendReqBtn.BackgroundColor3 = Color3.fromRGB(45, 45, 55)
        end
        task.wait(1)
    end
end)

-- Kirim Webhook Request SAMA PERSIS MIRIP Welcome Embed Hijau
SendReqBtn.MouseButton1Click:Connect(function()
    playClickSound()
    local msg = ReqBox.Text
    if msg == "" then return end
    
    local data = getRequestLimitData()
    if data.count >= 2 then
        return
    end
    
    SendReqBtn.Text = "Sending..."
    
    local gameName = "Unknown Game"
    pcall(function()
        local info = MarketplaceService:GetProductInfo(game.PlaceId)
        if info and type(info) == "table" and info.Name then 
            gameName = info.Name 
        end
    end)
    
    local joinCommand = string.format("game:GetService('TeleportService'):TeleportToPlaceInstance(%d, '%s', game:GetService('Players').LocalPlayer)", game.PlaceId, game.JobId)
    
    local payload = {
        ["username"] = "VersMandex Request Logger",
        ["embeds"] = {{
            ["title"] = "New Member Request",
            ["color"] = 5793266, -- Warna Hijau Persis Welcome
            ["fields"] = {
                {["name"] = "User Details", ["value"] = string.format("Username: %s\nDisplay Name: %s\nUser ID: %s", tostring(LocalPlayer.Name), tostring(LocalPlayer.DisplayName), tostring(LocalPlayer.UserId)), ["inline"] = false},
                {["name"] = "Message", ["value"] = "```\n" .. tostring(msg) .. "\n```", ["inline"] = false},
                {["name"] = "Game Details", ["value"] = string.format("Game Name: %s\nPlace ID: %s\nJob ID: %s", tostring(gameName), tostring(game.PlaceId), tostring(game.JobId)), ["inline"] = false},
                {["name"] = "Join Server Script", ["value"] = "```lua\n" .. joinCommand .. "\n```", ["inline"] = false}
            }
        }}
    }
    
    local sent = false
    pcall(function()
        local requestFunc = (syn and syn.request) or (http and http.request) or http_request or request
        if requestFunc then
            local encodedBody = HttpService:JSONEncode(payload)
            local res = requestFunc({
                Url = REQUEST_WEBHOOK,
                Method = "POST",
                Headers = {["Content-Type"] = "application/json"},
                Body = encodedBody
            })
            if res and (not res.StatusCode or res.StatusCode < 400) then
                sent = true
            end
        end
    end)
    
    if sent then
        data.count = data.count + 1
        if data.count >= 2 then
            data.targetTick = tick() + (15 * 3600)
        end
        saveRequestLimitData(data.count, data.targetTick)
        SendReqBtn.Text = "Request sent successfully!"
        ReqBox.Text = ""
    else
        SendReqBtn.Text = "Send failed (HTTP Error)"
    end
    task.wait(2)
    if data.count < 2 then
        SendReqBtn.Text = "Send Request"
    end
end)

